# 复制为本机私有环境变量文件或在命令行以 -e 传入；不要提交真实值。
BASE_URL=https://test.example.com
AUTHORIZATION=
ENTERPRISE_CODE=10000
PRODUCT_CODE=replace-with-test-product-code

# MODE: read（默认只读）| prepare（取业务码）| full（产生进件副作用）
MODE=read

# full 模式会把下列本地图片上传到测试环境，并以本次产生的 reqCode 关联：
# k6/fixtures/id-front.jpg
# k6/fixtures/id-back.jpg

# full 模式需要与明文测试客户匹配的加密字段。不要把 AES 密钥、令牌或真实数据提交到仓库。
DISPLAY_NAME=ATRC_TEST_USER
NAME_CIPHER=
ID_CARD_CIPHER=
PHONE_CIPHER=
CONTACT_NAME_CIPHER=
CONTACT_PHONE_CIPHER=
# 测试环境挡板：任意 6 位数字均通过。
VERIFY_CODE=123456

# 身份证正面 OCR 响应未包含 idImg 时才需要传入
ID_IMG_BASE64=
APPLY_AMOUNT=200000
LOAN_USE=2
LOAN_USE_DESC=O8010
